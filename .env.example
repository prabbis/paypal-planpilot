# Copy to .env.local for local Node development; never commit actual values.
DATA_BACKEND=firebase
PUBLIC_SITE_URL=http://localhost:3000
# Public Firebase web-app configuration (served by /api/auth/config).
FIREBASE_APIKEY=
FIREBASE_AUTHDOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APPID=
# Server-only JSON service account. Use a secret environment variable, not a file in the repository.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_COLLECTION_PREFIX=planpilot_
# Server-only provider credentials. Optional features report unavailable when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-5-mini
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_OWNER_EMAIL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
STORE_CREDENTIAL_KEY=
NEXT_TELEMETRY_DISABLED=1
